{
  "name": "ocean-intelligence-frontend",
  "version": "0.1.0",
  "type": "module",
  "description": "React + Vite + Cesium frontend for SIH26067 ocean visualization",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "cesium:assets": "node scripts/copyCesiumAssets.js",
    "postinstall": "npm run cesium:assets",
    "dev": "npm run cesium:assets && vite",
    "build": "npm run cesium:assets && vite build",
    "lint": "eslint .",
    "test": "node --test src/services/*.test.js src/utils/*.test.js",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "cesium": "^1.120.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "vite": "^5.4.11",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^5.0.0"
  }
}
