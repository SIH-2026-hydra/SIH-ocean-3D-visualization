APP_NAME=Ocean Intelligence API
APP_ENV=development
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
OCEAN_PROVIDER=auto
# "auto" uses a valid locally staged Copernicus dataset when present. Use
# "copernicus" to require it, or "json" only for testing/development fixtures.
# Paths are local to the backend process.
COPERNICUS_TEMPERATURE_PATH=../real_data_test/temperature_depth_0_500.nc
COPERNICUS_SALINITY_PATH=../real_data_test/salinity.nc
COPERNICUS_CURRENT_U_PATH=../real_data_test/currents.nc
COPERNICUS_CURRENT_V_PATH=../real_data_test/currents.nc
# Stage the real regional Copernicus NetCDF bundle here. The directory must
# cover the Arabian Sea, Bay of Bengal, and Indian Ocean operational envelope.
COPERNICUS_DATA_DIR=../operational_data
COPERNICUS_FILE_PATTERN=*.nc
COPERNICUS_VALIDATE_ON_STARTUP=true
COPERNICUS_LOG_LEVEL=INFO
COPERNICUS_OPERATIONAL_MIN_LATITUDE=-30
COPERNICUS_OPERATIONAL_MAX_LATITUDE=30
COPERNICUS_OPERATIONAL_MIN_LONGITUDE=40
COPERNICUS_OPERATIONAL_MAX_LONGITUDE=105
# On-demand acquisition is disabled until Copernicus credentials and the
# optional ``copernicusmarine`` package are configured for this environment.
COPERNICUS_CACHE_DIR=app/data/operational_cache
COPERNICUS_ACQUISITION_ENABLED=false
