APP_NAME=Ocean Intelligence API
APP_ENV=development
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
OCEAN_PROVIDER=auto
# "auto" uses a valid locally staged Copernicus dataset when present. Use
# "copernicus" to require it, or "json" only for testing/development fixtures.
# Paths are local to the backend process.
COPERNICUS_TEMPERATURE_PATH=../real_data_test/temperature_depth_0_500.nc
COPERNICUS_SALINITY_PATH=../real_data_test/salinity.nc
COPERNICUS_CURRENT_U_PATH=../real_data_test/currents.nc
COPERNICUS_CURRENT_V_PATH=../real_data_test/currents.nc
COPERNICUS_DATA_DIR=../real_data_test
COPERNICUS_FILE_PATTERN=*.nc
COPERNICUS_VALIDATE_ON_STARTUP=true
COPERNICUS_LOG_LEVEL=INFO
